{
  "comments": {
    "lineComment": ";",
    "blockComment": ["; ", ""]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    ["'", "'"],
    ["(", ")"],
    ["[", "]"]
  ],
  "wordPattern": "[a-zA-Z_$%\\.][0-9a-zA-Z_$%\\.]*"
}
